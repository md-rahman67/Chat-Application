<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Chats</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/chats.css">
</head>

<body>
    <h1>Chatbox</h1>
    <a href="/chats/new" style="color: blue;">new chat</a>
    <hr>
    <% for(chat of chats){ %>

        <div class="chat">
            <p><b>From: </b><i>
                    <%= chat.from %>
                </i></p>
            <p id="msg">
                <%= chat.msg %>&nbsp;&nbsp;&nbsp;&nbsp;
                    <a href="/chats/<%= chat._id %>/edit" style="text-decoration: none;"> <b
                            style="color: white;">⋮</b></a>
            </p>
            <p><b>Recived by: </b><i>
                    <%= chat.to %>
                </i></p>
            <hr>
            <p>
                <%= chat.created_at.toString().split(" ")[4] %></p>
            <p><%= chat.created_at.toString().split(" ").slice(0,4).join(" -") %>
            </p>

            <form action="/chats/<%= chat._id %>?_method=DELETE" method="post">
                <button type="submit" onclick="return confirm('Are you sure you want to delete this chat?');"><i
                        class="fa-solid fa-trash" style="color: blue;"></i></button>
            </form>

        </div>
        <br>

        <% } %>





</body>

</html>