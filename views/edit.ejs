<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit message</title>
</head>
<body>
    <p><b>Edit your chat:</b> <%= chat._id %>.</p>
    <p>Chat was sent from <b><%= chat.from %></b> to <b><%= chat.to %></b>.</p>

    <form action="/chats/<%= chat._id %>?_method=PUT" method="post">
        <textarea name="msg" rows="5"><%= chat.msg %></textarea>
        <button type="submit">edit</button>
    </form>
</body>
</html>